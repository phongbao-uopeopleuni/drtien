---
import { expertise } from '../data/portfolio';
import Icon from './Icon.astro';
const icons = ['shield', 'network', 'layers'] as const;
---
<section id="expertise" class="section section-expertise" aria-labelledby="expertise-title">
  <div class="container expertise-grid">
    <div class="section-heading"><p class="eyebrow"><span class="section-number">04</span>Research expertise</p><h2 id="expertise-title">Methods behind<br /><em>the questions.</em></h2><p class="section-description">Research experience across molecular, cellular and tissue-level approaches.</p></div>
    <div class="expertise-list">{expertise.map((group, index) => <div class="expertise-group"><span class="expertise-number"><Icon name={icons[index] ?? 'layers'} size={21} /></span><div><h3>{group.title}</h3><p>{group.description}</p><ul class="skill-tags" aria-label={`${group.title} techniques`}>{group.skills.map(skill => <li>{skill}</li>)}</ul></div></div>)}</div>
  </div>
</section>
