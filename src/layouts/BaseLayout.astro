---
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/wght-italic.css';
import '../styles/global.css';
import { assetUrl, isDraft, profile } from '../data/portfolio';
const title = `${profile.name} — ${profile.currentTitle} | Research Portfolio`;
const description = `${profile.name}, ${profile.currentTitle} at ${profile.affiliation}. Research in veterinary virology, host–virus interactions, innate immunity and experimental pathology.`;
const canonical = Astro.site ? new URL(import.meta.env.BASE_URL, Astro.site).href : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#263c32" />
    <meta name="robots" content={isDraft ? 'noindex, nofollow' : 'index, follow'} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={assetUrl('/favicon.svg')} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {Astro.site && <meta property="og:image" content={new URL(assetUrl('/social-card.png'), Astro.site).href} />}
    <meta property="og:image:alt" content={`${profile.name} — Veterinary Virology & Immunopathology`} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
